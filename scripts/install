#!/usr/bin/env bash
# install - put protonup and flatseal on a Steam Deck (or any x86_64 Linux): two binaries in ~/.local/bin,
# menu entries for Desktop Mode, optionally a weekly Proton-GE update timer. No root, nothing else is
# installed: no Python, no Qt, no GTK.
#
#   curl -fsSL https://raw.githubusercontent.com/Gucixdev/steamdeck/main/scripts/install | bash
#   curl -fsSL https://raw.githubusercontent.com/Gucixdev/steamdeck/main/scripts/install | bash -s -- --timer
#
# options
#   --only NAME        install just protonup or flatseal (repeatable)
#   --prefix DIR       install under DIR (default ~/.local): bin/, share/applications/, share/icons/
#   --version TAG      a release tag instead of the latest
#   --from DIR         take the binaries and SHA256SUMS from DIR instead of downloading (offline)
#   --timer            also install a systemd user timer that runs `protonup install latest` weekly
#   --no-desktop       do not write menu entries or icons
#   --uninstall        remove what this script installed
#   --dry-run          print what would happen, change nothing
#   -h, --help         this text
#
# Machine-wide tuning (OOM guard, swap, sysctl, ssh) is the `setup` wizard in the repo root (scripts/system does the work).
set -euo pipefail

REPO=${STEAMDECK_REPO:-Gucixdev/steamdeck}
PREFIX=${HOME}/.local
VERSION=latest
FROM=
TIMER=0
DESKTOP=1
UNINSTALL=0
DRY=0
ONLY=()
ALL=(protonup flatseal)
SUFFIX=x86_64-linux

say() { printf '%s\n' "$*"; }
die() { printf 'install: %s\n' "$*" >&2; exit 1; }
run() { if [ "$DRY" = 1 ]; then printf '+ %s\n' "$*"; else "$@"; fi; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
	case $1 in
		--only) ONLY+=("${2:?--only needs a name}"); shift ;;
		--prefix) PREFIX=${2:?--prefix needs a directory}; shift ;;
		--version) VERSION=${2:?--version needs a tag}; shift ;;
		--from) FROM=${2:?--from needs a directory}; shift ;;
		--timer) TIMER=1 ;;
		--no-desktop) DESKTOP=0 ;;
		--uninstall) UNINSTALL=1 ;;
		--dry-run) DRY=1 ;;
		-h|--help) usage; exit 0 ;;
		*) die "unknown option $1 (see --help)" ;;
	esac
	shift
done

APPS=("${ALL[@]}")
if [ ${#ONLY[@]} -gt 0 ]; then
	APPS=()
	for n in "${ONLY[@]}"; do
		case $n in protonup|flatseal) APPS+=("$n") ;; *) die "no such tool '$n' (protonup, flatseal)" ;; esac
	done
fi

BIN=$PREFIX/bin
APPDIR=$PREFIX/share/applications
ICONDIR=$PREFIX/share/icons/hicolor/scalable/apps
UNITDIR=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user

title() { case $1 in protonup) echo "ProtonUp" ;; flatseal) echo "Flatseal" ;; esac; }
comment() {
	case $1 in
		protonup) echo "Install and remove Proton-GE and other compatibility tools" ;;
		flatseal) echo "Edit Flatpak permission overrides" ;;
	esac
}
icon_color() { case $1 in protonup) echo "#7b3fe4" ;; flatseal) echo "#00c853" ;; esac; }
icon_glyph() { case $1 in protonup) echo "P" ;; flatseal) echo "F" ;; esac; }

write_file() { # path, mode; content on stdin
	local path=$1 mode=${2:-644}
	if [ "$DRY" = 1 ]; then printf '+ write %s\n' "$path"; cat >/dev/null; return; fi
	mkdir -p "$(dirname "$path")"
	local tmp="$path.tmp.$$"
	cat >"$tmp"
	chmod "$mode" "$tmp"
	mv -f "$tmp" "$path"
}

uninstall() {
	local n
	for n in "${APPS[@]}"; do
		run rm -f "$BIN/$n" "$APPDIR/$n.desktop" "$ICONDIR/$n.svg"
	done
	if [ -f "$UNITDIR/protonup-update.timer" ]; then
		if command -v systemctl >/dev/null && [ -z "${STEAMDECK_NO_SYSTEMD:-}" ]; then run systemctl --user disable --now protonup-update.timer 2>/dev/null || true; fi
		run rm -f "$UNITDIR/protonup-update.timer" "$UNITDIR/protonup-update.service"
		if command -v systemctl >/dev/null && [ -z "${STEAMDECK_NO_SYSTEMD:-}" ]; then run systemctl --user daemon-reload 2>/dev/null || true; fi
	fi
	command -v update-desktop-database >/dev/null && run update-desktop-database "$APPDIR" 2>/dev/null || true
	say "removed from $PREFIX"
}

if [ "$UNINSTALL" = 1 ]; then
	uninstall
	exit 0
fi

[ "$(uname -s)" = Linux ] || die "Linux only"
case $(uname -m) in x86_64|amd64) ;; *) die "x86_64 only (this is $(uname -m))" ;; esac
command -v sha256sum >/dev/null || die "sha256sum not found"

fetch() { # url, destination
	if command -v curl >/dev/null; then
		curl -fsSL --retry 3 -o "$2" "$1"
	elif command -v wget >/dev/null; then
		wget -q -O "$2" "$1"
	else
		die "need curl or wget"
	fi
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

if [ -n "$FROM" ]; then
	[ -d "$FROM" ] || die "--from: $FROM is not a directory"
	SRC=$FROM
	say "using local files from $FROM"
else
	if [ "$VERSION" = latest ]; then
		BASE=${STEAMDECK_RELEASE_URL:-https://github.com/$REPO/releases/latest/download}
	else
		BASE=${STEAMDECK_RELEASE_URL:-https://github.com/$REPO/releases/download/$VERSION}
	fi
	say "downloading $VERSION from $BASE"
	fetch "$BASE/SHA256SUMS" "$WORK/SHA256SUMS" || die "could not fetch SHA256SUMS from $BASE"
	for n in "${APPS[@]}"; do
		fetch "$BASE/$n-$SUFFIX" "$WORK/$n-$SUFFIX" || die "could not fetch $n"
	done
	SRC=$WORK
fi

[ -f "$SRC/SHA256SUMS" ] || die "no SHA256SUMS next to the binaries"
for n in "${APPS[@]}"; do
	f=$n-$SUFFIX
	[ -f "$SRC/$f" ] || die "$SRC/$f is missing"
	want=$(awk -v f="$f" '$2 == f || $2 == "*" f {print $1}' "$SRC/SHA256SUMS" | head -1)
	[ -n "$want" ] || die "$f is not listed in SHA256SUMS"
	got=$(sha256sum "$SRC/$f" | awk '{print $1}')
	[ "$want" = "$got" ] || die "checksum mismatch for $f (expected ${want:0:16}..., got ${got:0:16}...): nothing installed"
done

for n in "${APPS[@]}"; do
	f=$n-$SUFFIX
	if [ "$DRY" = 1 ]; then
		printf '+ install %s -> %s/%s\n' "$f" "$BIN" "$n"
	else
		mkdir -p "$BIN"
		install -m 755 "$SRC/$f" "$BIN/$n.new.$$"
		mv -f "$BIN/$n.new.$$" "$BIN/$n"
	fi
	say "installed $BIN/$n"
done

if [ "$DESKTOP" = 1 ]; then
	for n in "${APPS[@]}"; do
		write_file "$ICONDIR/$n.svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><rect width="128" height="128" rx="24" fill="#0b0b10"/><circle cx="64" cy="64" r="48" fill="none" stroke="$(icon_color "$n")" stroke-width="10"/><text x="64" y="86" text-anchor="middle" font-family="monospace" font-weight="bold" font-size="64" fill="#00ff41">$(icon_glyph "$n")</text></svg>
SVG
		write_file "$APPDIR/$n.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=$(title "$n")
Comment=$(comment "$n")
Exec=$BIN/$n
Icon=$n
Terminal=false
Categories=Utility;Game;
DESK
	done
	command -v update-desktop-database >/dev/null && run update-desktop-database "$APPDIR" 2>/dev/null || true
fi

if [ "$TIMER" = 1 ]; then
	case " ${APPS[*]} " in *" protonup "*) ;; *) die "--timer needs protonup in the install" ;; esac
	write_file "$UNITDIR/protonup-update.service" <<UNIT
[Unit]
Description=Install the newest Proton-GE

[Service]
Type=oneshot
ExecStart=$BIN/protonup install latest
UNIT
	write_file "$UNITDIR/protonup-update.timer" <<UNIT
[Unit]
Description=Weekly Proton-GE update

[Timer]
OnCalendar=weekly
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
	if command -v systemctl >/dev/null && [ -z "${STEAMDECK_NO_SYSTEMD:-}" ]; then
		run systemctl --user daemon-reload || true
		run systemctl --user enable --now protonup-update.timer || say "could not enable the timer (no user systemd session?); the unit files are in $UNITDIR"
	fi
	say "weekly Proton-GE update timer installed"
fi

case ":$PATH:" in *":$BIN:"*) ;; *) say "note: $BIN is not in your PATH; run the tools by full path or add it" ;; esac
say "done. Desktop Mode: find ProtonUp and Flatseal in the application menu."
say "Gaming Mode: Steam (Desktop Mode) > Games > Add a Non-Steam Game > ProtonUp / Flatseal."
