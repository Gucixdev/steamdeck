#!/usr/bin/env bash
# setup - a wizard for a fresh Steam Deck: asks what you want, shows the list, then does it.
#
#   ./setup                  ask, confirm, apply
#
# It runs two scripts from scripts/: `install` (ProtonUp and Flatseal into ~/.local/bin) and `system`
# (OOM guard, sysctl, swap file, ssh; asks sudo once). Nothing is changed until you confirm the summary.
# Testing only: --dry-run prints what would run, --root DIR writes the /etc files under DIR.
set -euo pipefail

HERE=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
DRY=()
ROOTOPT=()
while [ $# -gt 0 ]; do
	case $1 in
		--dry-run) DRY=(--dry-run) ;;
		--root) ROOTOPT=(--root "${2:?--root needs a directory}"); shift ;;
		-h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "setup: unknown option $1" >&2; exit 2 ;;
	esac
	shift
done

# ask_yn TEXT DEFAULT(y|n) -> sets YES=1/0 ; end of input takes the default
ask_yn() {
	local def=$2 hint ans
	[ "$def" = y ] && hint='[Y/n]' || hint='[y/N]'
	while :; do
		read -rp "  $1 $hint " ans || ans=
		case ${ans:-$def} in
			[Yy]*) YES=1; return ;;
			[Nn]*) YES=0; return ;;
			*) echo "    answer y or n" ;;
		esac
	done
}

# ask_val TEXT DEFAULT REGEX -> sets VAL
ask_val() {
	local ans
	while :; do
		read -rp "  $1 [$2] " ans || ans=
		ans=${ans:-$2}
		if [[ $ans =~ $3 ]]; then VAL=$ans; return; fi
		echo "    not a valid value"
	done
}

echo "steamdeck setup: answer a few questions; nothing changes until you confirm at the end."
echo

echo "Programs"
ask_yn "Install ProtonUp and Flatseal (into ~/.local/bin, with menu entries)?" y; DO_INSTALL=$YES
DO_TIMER=0
if [ "$DO_INSTALL" = 1 ]; then
	ask_yn "Update Proton-GE once a week in the background?" n; DO_TIMER=$YES
fi

echo
echo "System (asks for your sudo password once)"
ask_yn "OOM guard: kill the game instead of freezing the Deck when memory runs out?" y; DO_OOM=$YES
ask_yn "Memory settings tuned for zram (swappiness, cache pressure)?" y; DO_SYSCTL=$YES
SWAPPINESS=100
if [ "$DO_SYSCTL" = 1 ]; then
	ask_val "swappiness (0-200, 100 suits zram)" 100 '^([0-9]|[1-9][0-9]|1[0-9][0-9]|200)$'; SWAPPINESS=$VAL
fi
echo "    swap now: $(free -h 2>/dev/null | awk '/^Swap:/{print $2" total, "$3" used"}')"
ask_val "Swap file size, e.g. 8G or 16G (Enter keeps it)" keep '^(keep|[0-9]+[GgMm])$'; SWAPSIZE=$VAL
ask_yn "Enable ssh so you can log in from another computer?" n; DO_SSH=$YES

# --- the plan -------------------------------------------------------------
INSTALL_CMD=()
if [ "$DO_INSTALL" = 1 ]; then
	INSTALL_CMD=("$HERE/scripts/install" "${DRY[@]}")
	[ -d "$HERE/dist" ] && INSTALL_CMD+=(--from "$HERE/dist")
	[ "$DO_TIMER" = 1 ] && INSTALL_CMD+=(--timer)
fi
SYSTEM_CMD=()
if [ "$DO_OOM$DO_SYSCTL$DO_SSH" != 000 ] || [ "$SWAPSIZE" != keep ]; then
	SYSTEM_CMD=("$HERE/scripts/system" "${DRY[@]}" "${ROOTOPT[@]}")
	[ "$DO_SYSCTL" = 1 ] && SYSTEM_CMD+=(--swappiness "$SWAPPINESS")
	[ "$DO_OOM" = 1 ] && SYSTEM_CMD+=(oom)
	[ "$DO_SYSCTL" = 1 ] && SYSTEM_CMD+=(sysctl)
	[ "$SWAPSIZE" != keep ] && SYSTEM_CMD+=(swapfile "$SWAPSIZE")
	[ "$DO_SSH" = 1 ] && SYSTEM_CMD+=(ssh)
fi

echo
echo "This will:"
[ "$DO_INSTALL" = 1 ] && echo "  - install ProtonUp and Flatseal$([ "$DO_TIMER" = 1 ] && echo ', with a weekly Proton-GE update')"
[ "$DO_OOM" = 1 ] && echo "  - set up the OOM guard (systemd-oomd)"
[ "$DO_SYSCTL" = 1 ] && echo "  - write memory settings (swappiness $SWAPPINESS)"
[ "$SWAPSIZE" != keep ] && echo "  - resize the swap file to $SWAPSIZE"
[ "$DO_SSH" = 1 ] && echo "  - enable ssh"
if [ ${#INSTALL_CMD[@]} -eq 0 ] && [ ${#SYSTEM_CMD[@]} -eq 0 ]; then
	echo "  (nothing)"
	exit 0
fi
echo
ask_yn "Go ahead?" y
[ "$YES" = 1 ] || { echo "cancelled, nothing changed"; exit 0; }

echo
[ ${#INSTALL_CMD[@]} -gt 0 ] && "${INSTALL_CMD[@]}"
[ ${#SYSTEM_CMD[@]} -gt 0 ] && "${SYSTEM_CMD[@]}"
echo
echo "done. To undo the system part later: scripts/system undo"
